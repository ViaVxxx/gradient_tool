{
  "name": "gradient-tool-web",
  "version": "2.1.0",
  "type": "module",
  "description": "Modern gradient image generator with web UI",
  "scripts": {
    "wasm:build": "cd ../../src-wasm && wasm-pack build --target web --out-dir ../web-version/web/src/wasm-pkg",
    "wasm:dev": "cd ../../src-wasm && wasm-pack build --dev --target web --out-dir ../web-version/web/src/wasm-pkg",
    "dev": "npm run wasm:dev && vite",
    "build": "npm run wasm:build && vite build",
    "preview": "vite preview",
    "tauri:dev": "npm run wasm:dev && tauri dev",
    "tauri:build": "npm run wasm:build && tauri build"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/cli": "^2.9.6",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "daisyui": "^5.5.14",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  }
}
